# Cadena de conexion a PostgreSQL.
# En local (docker): postgres://reservas:reservas@localhost:5432/reservas
# En Railway se inyecta automaticamente al enlazar el servicio Postgres.
DATABASE_URL=postgres://reservas:reservas@localhost:5432/reservas

# Puerto del servidor Express (Railway define PORT automaticamente).
PORT=3001

# Origen permitido para CORS en desarrollo (el cliente Vite).
CLIENT_ORIGIN=http://localhost:5173

# TLS contra PostgreSQL: desactivado por defecto (Railway usa red privada sin SSL).
# Actívalo solo si tu proveedor lo exige (Neon, Supabase, Heroku): PGSSLMODE=require
# PGSSLMODE=require

# Base de datos usada por las pruebas de integracion del repositorio.
# Si no se define, esas pruebas se saltan y el resto de la suite sigue funcionando.
TEST_DATABASE_URL=postgres://reservas:reservas@localhost:5432/reservas_test
