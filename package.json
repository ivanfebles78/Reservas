{
  "name": "reservas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gestion de reservas de calzado: alta de peticiones de clientes y seguimiento de estados",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "node server/src/index.js",
    "migrate": "node server/src/db/migrate.js",
    "test": "npm run test --workspace server",
    "test:coverage": "npm run test:coverage --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
